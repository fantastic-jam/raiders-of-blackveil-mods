<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--
      Shared build settings for all mods (BepInEx 6 IL2CPP).
      Game references are Il2CppInterop wrapper assemblies generated by `pnpm run setup`
      into game-lib/il2cpp/interop/. Loader references come from the local bepinex/ folder.
      Add mod-specific interop references in the mod's .csproj with $(InteropDir).
    -->
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>10</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <InteropDir>$(MSBuildThisFileDirectory)..\game-lib\il2cpp\interop\</InteropDir>
        <BepInExCoreDir>$(MSBuildThisFileDirectory)..\bepinex\BepInEx\core\</BepInExCoreDir>
    </PropertyGroup>
    <ItemGroup>
        <!-- Loader -->
        <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)0Harmony.dll" Private="False" />
        <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)BepInEx.Core.dll" Private="False" />
        <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll" Private="False" />
        <Reference Include="Il2CppInterop.Common" HintPath="$(BepInExCoreDir)Il2CppInterop.Common.dll" Private="False" />
        <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="False" />
        <Reference Include="SemanticVersioning" HintPath="$(BepInExCoreDir)SemanticVersioning.dll" Private="False" />

        <!-- Game (Il2CppInterop wrappers) -->
        <Reference Include="Il2Cppmscorlib" HintPath="$(InteropDir)Il2Cppmscorlib.dll" Private="False" />
        <Reference Include="Il2CppSystem" HintPath="$(InteropDir)Il2CppSystem.dll" Private="False" />
        <Reference Include="Il2CppSystem.Core" HintPath="$(InteropDir)Il2CppSystem.Core.dll" Private="False" />
        <Reference Include="Assembly-CSharp" HintPath="$(InteropDir)Assembly-CSharp.dll" Private="False" />
        <Reference Include="Assembly-CSharp-firstpass" HintPath="$(InteropDir)Assembly-CSharp-firstpass.dll" Private="False" />
        <Reference Include="Unity.TextMeshPro" HintPath="$(InteropDir)Unity.TextMeshPro.dll" Private="False" />
        <Reference Include="UnityEngine" HintPath="$(InteropDir)UnityEngine.dll" Private="False" />
        <Reference Include="UnityEngine.CoreModule" HintPath="$(InteropDir)UnityEngine.CoreModule.dll" Private="False" />
        <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(InteropDir)UnityEngine.ImageConversionModule.dll" Private="False" />
        <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(InteropDir)UnityEngine.InputLegacyModule.dll" Private="False" />
        <Reference Include="UnityEngine.UI" HintPath="$(InteropDir)UnityEngine.UI.dll" Private="False" />
        <Reference Include="UnityEngine.UIModule" HintPath="$(InteropDir)UnityEngine.UIModule.dll" Private="False" />
        <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(InteropDir)UnityEngine.TextRenderingModule.dll" Private="False" />
        <Reference Include="Unity.InputSystem" HintPath="$(InteropDir)Unity.InputSystem.dll" Private="False" />
        <Reference Include="Fusion.Common" HintPath="$(InteropDir)Fusion.Common.dll" Private="False" />
        <Reference Include="Fusion.Runtime" HintPath="$(InteropDir)Fusion.Runtime.dll" Private="False" />
        <Reference Include="Fusion.Sockets" HintPath="$(InteropDir)Fusion.Sockets.dll" Private="False" />
    </ItemGroup>
</Project>
