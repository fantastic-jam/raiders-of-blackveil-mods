<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\UserPaths.props" Condition="Exists('..\UserPaths.props')" />
  <Import Project="..\Common.props" />

  <PropertyGroup>
    <AssemblyName>WildguardModFramework</AssemblyName>
    <RootNamespace>WildguardModFramework</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DefineConstants>WMF_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(InteropDir)UnityEngine.IMGUIModule.dll" Private="False" />
    <Reference Include="UnityEngine.UIElementsModule" HintPath="$(InteropDir)UnityEngine.UIElementsModule.dll" Private="False" />
    <Reference Include="UniTask" HintPath="$(InteropDir)UniTask.dll" Private="False" />
    <!-- SessionProperty (Fusion session custom properties) — used by PresenceProtocol. -->
    <Reference Include="Fusion.Realtime" HintPath="$(InteropDir)Fusion.Realtime.dll" Private="False" />
    <!-- BepInEx INativeDetour (native detour for Span-parameter methods Harmony cannot call) -->
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(BepInExCoreDir)MonoMod.RuntimeDetour.dll" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\ModRegistry\ModRegistry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Localization\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
