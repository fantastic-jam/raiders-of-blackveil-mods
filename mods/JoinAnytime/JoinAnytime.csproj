<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\UserPaths.props" Condition="Exists('..\UserPaths.props')" />
  <Import Project="..\Common.props" />

  <PropertyGroup>
    <AssemblyName>JoinAnytime</AssemblyName>
    <RootNamespace>JoinAnytime</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- JoinableSessions.AnnounceToLobbyListAsync returns a UniTask (LobbyListing). -->
    <Reference Include="UniTask" HintPath="$(InteropDir)UniTask.dll" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WildguardModFramework\WildguardModFramework.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
