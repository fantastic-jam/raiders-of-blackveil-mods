# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# GitHub personal access token — required for `pnpm run release`.
# Needed scopes: repo (create releases, upload assets).
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Nexus Mods personal API key — used locally to look up Nexus ids (see docs/dev/create_mod.md).
# CI uses the NEXUS_API_KEY repo secret: gh secret set NEXUS_API_KEY
# Get one at: https://www.nexusmods.com/settings/api-keys
NEXUS_TOKEN=
