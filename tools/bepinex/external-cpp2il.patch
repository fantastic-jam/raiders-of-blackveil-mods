+    /// <summary>
+    /// Runs a standalone Cpp2IL in its own process and loads its dummy DLLs with BepInEx's own AsmResolver.
+    /// Newer Cpp2IL builds depend on AsmResolver 6.x, which is not binary compatible with the version
+    /// Il2CppInterop is built against, so they cannot share this process.
+    /// </summary>
+    private static List<AsmResolver.DotNet.AssemblyDefinition> RunExternalCpp2Il(string cpp2IlPath, string metadataPath)
+    {
+        var outputDir = Path.Combine(IL2CPPBasePath, "cpp2il-out");
+        if (Directory.Exists(outputDir))
+            Directory.Delete(outputDir, true);
+        Directory.CreateDirectory(outputDir);
+
+        var unityVersion = UnityInfo.Version;
+        var args = new[]
+        {
+            "--force-binary-path", GameAssemblyPath,
+            "--force-metadata-path", metadataPath,
+            "--force-unity-version", $"{unityVersion.Major}.{unityVersion.Minor}.{unityVersion.Build}",
+            "--use-processor", "attributeinjector",
+            "--output-as", "dummydll",
+            "--output-to", outputDir,
+        };
+
+        Logger.LogMessage($"Running external Cpp2IL ({cpp2IlPath}) to generate dummy assemblies from {metadataPath}");
+        var stopwatch = Stopwatch.StartNew();
+        var cpp2IlLogger = BepInEx.Logging.Logger.CreateLogSource("Cpp2IL");
+
+        var startInfo = new ProcessStartInfo(cpp2IlPath)
+        {
+            UseShellExecute = false,
+            CreateNoWindow = true,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            WorkingDirectory = Path.GetDirectoryName(cpp2IlPath)!,
+        };
+        foreach (var arg in args)
+            startInfo.ArgumentList.Add(arg);
+
+        using (var process = new Process { StartInfo = startInfo })
+        {
+            process.OutputDataReceived += (_, e) => { if (!string.IsNullOrWhiteSpace(e.Data)) cpp2IlLogger.LogInfo(StripAnsi(e.Data)); };
+            process.ErrorDataReceived += (_, e) => { if (!string.IsNullOrWhiteSpace(e.Data)) cpp2IlLogger.LogError(StripAnsi(e.Data)); };
+            process.Start();
+            process.BeginOutputReadLine();
+            process.BeginErrorReadLine();
+            process.WaitForExit();
+            if (process.ExitCode != 0)
+                throw new InvalidOperationException($"External Cpp2IL exited with code {process.ExitCode}");
+        }
+
+        var assemblies = Directory.EnumerateFiles(outputDir, "*.dll")
+                                  .Select(AsmResolver.DotNet.AssemblyDefinition.FromFile)
+                                  .ToList();
+        if (assemblies.Count == 0)
+            throw new InvalidOperationException("External Cpp2IL produced no assemblies");
+
+        stopwatch.Stop();
+        Logger.LogInfo($"External Cpp2IL finished in {stopwatch.Elapsed} ({assemblies.Count} assemblies)");
+        return assemblies;
+    }
+
+    private static string StripAnsi(string text) => Regex.Replace(text, @"\x1B\[[0-9;]*m", string.Empty);
+
